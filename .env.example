# Copy to .env and edit. Every setting is optional — LegalLens runs with no .env at all.

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_EXPIRE_HOURS=24
MAX_UPLOAD_MB=20

# --- Database (default: SQLite file data/legallens.db) ---
# DATABASE_URL=postgresql+psycopg2://legallens:password@localhost:5432/legallens

# --- LLM (optional). auto = first configured of Anthropic, OpenAI, Ollama; none = rule-based only ---
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible server (Groq, LM Studio, vLLM...)
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1                          # local, free, offline
# LLM_TIMEOUT=90

# --- Embeddings: auto | sbert | lsa ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store: auto | chroma | numpy ---
VECTOR_STORE=auto

# --- CAG cache: Redis if set, otherwise in-memory + disk (cache/) ---
# REDIS_URL=redis://localhost:6379/0

# --- OCR ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng

# --- Frontend dev server origin(s) allowed by CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
